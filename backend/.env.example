PORT=4000

# Configuración de la base de datos PostgreSQL
DB_USER=postgres
DB_PASSWORD=tu_contraseña
DB_HOST=localhost
DB_PORT=5432
DB_NAME=manga_app

# Configuración de seguridad para los Tokens
JWT_SECRET=genera_una_clave_segura_aqui

# Google OAuth
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# Correo (restablecer contraseña). Clave de https://resend.com y remitente de un dominio verificado.
RESEND_API_KEY=
MAIL_FROM=KamiTales <no-responder@tudominio.com>
# Dirección pública de la web para los enlaces de los correos (sin barra final)
APP_URL=https://tudominio.com

# SUPABASE_URL: en Supabase → Settings → API (no la escribas nunca en el código)
SUPABASE_URL=

# SUPABASE_SERVICE_KEY: en Supabase → Settings → API (no la escribas nunca en el código)
SUPABASE_SERVICE_KEY=

# Opcional: dirección de vuelta de Google (si no, se deduce del dominio de la petición)
GOOGLE_REDIRECT_URI=

# ── Pagos (Stripe) ───────────────────────────────────────────────────────────
# Sin estas claves la página Premium sigue diciendo «Muy pronto».
# Usa las de PRUEBA (sk_test_…) hasta abrir los cobros reales.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Dirección pública a la que Stripe devuelve al usuario tras pagar (sin barra final).
PUBLIC_URL=
# Opcional: 'true' si has activado Stripe Tax para calcular el IVA por país.
STRIPE_AUTOMATIC_TAX=
# IVA incluido en los precios cuando Stripe no lo informa (sin Stripe Tax).
# Se descuenta antes de repartir a los autores. Por defecto 21; 0 lo desactiva.
VAT_FALLBACK_PCT=
